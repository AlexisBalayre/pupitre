# Project profile: the one place stack-specific commands and patterns live.
# Read by .claude/hooks/*.sh, scripts/worktree-*.sh and scripts/pre-commit through
# .claude/hooks/lib/project-env.sh: KEY=value lines only, parsed and never sourced,
# so this file cannot run code inside a hook. It holds no secrets; keep it that way.
# An empty value turns off the check that uses it.

# Source file extensions (space-separated, no dot) that trigger the Stop hooks.
SOURCE_EXTENSIONS="ts tsx"

# Run by quality-checks.sh on every Stop. FORMAT_FIX_CMD and LINT_CMD get the
# dirty source files appended as arguments; TYPECHECK_CMD runs on the whole repo.
FORMAT_FIX_CMD="pnpm exec biome check --write"
LINT_CMD="pnpm exec biome check"
TYPECHECK_CMD="pnpm typecheck"

# Run by scripts/pre-commit (not on Stop: the Vitest suite is too slow for every turn).
TEST_CMD="pnpm test"

# Run by scripts/worktree-create.sh in a fresh worktree.
INSTALL_CMD="pnpm install"

# protect-generated.sh blocks Edit/Write on paths matching this ERE.
# pnpm-lock.yaml is the only generated file this repo commits.
GENERATED_PATHS_REGEX='(^|/)pnpm-lock\.yaml$'

# validate-file-naming.sh: new files whose path matches FILE_NAMING_SCOPE_REGEX
# must have a basename matching FILE_NAMING_REGEX; FILE_NAMING_HINT is shown on a block.
# kebab-case.role.ts with the 25 roles of docs/conventions/naming.md; index/env/main/app/setup,
# *.d.ts and *.config.ts need no role.
FILE_NAMING_SCOPE_REGEX='(^|/)src/.*\.tsx?$'
FILE_NAMING_REGEX='^((index|env|main|app|setup)\.tsx?|.*\.d\.ts|.*\.config\.ts|[a-z0-9]([a-z0-9-]*[a-z0-9])?\.(service|routes|schemas|serializer|types|interface|enums|constants|test|integration\.test|repository|manager|adapter|factory|config|utils|hook|component|store|errors|middleware|client|mock|registry|script)\.tsx?)$'
FILE_NAMING_HINT='Expected kebab-case.role.ts, e.g. my-service.service.ts, message-frame.types.ts, db-client.test.ts (a test flattens its subject dots to hyphens). Roles: service repository serializer middleware routes manager factory client adapter registry config types interface schemas enums constants errors component hook store test integration.test mock utils script.'

# Git worktree workflow (scripts/worktree-*.sh, .claude/hooks/git-safety.sh).
GIT_TRUNK=main
WORKTREE_BRANCH_PREFIX=feature
