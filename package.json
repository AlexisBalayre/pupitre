{
  "name": "pupitre",
  "version": "0.1.0",
  "description": "Control plane for parallel Claude Code sessions",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "pup": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "worktree:create": "bash scripts/worktree-create.sh",
    "worktree:clean": "bash scripts/worktree-clean.sh"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "commander": "^15.0.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
