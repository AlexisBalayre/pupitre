# ---------------------------------------------------------------------------
# Personalization hub. Copy to .env (gitignored) and fill in your own values.
#
#   cp .env.example .env
#
# Skills read these keys when they need them; the worktree scripts and the
# git-safety hook source this file. NEVER commit real account IDs or paths.
# ---------------------------------------------------------------------------

# obsidian-vault skill — absolute path to your Obsidian vault
OBSIDIAN_VAULT="$HOME/Documents/notes"

# to-issues / to-epic skills — IDs from your issue tracker (e.g. Linear).
# Leave blank to have Claude prompt you instead.
TRACKER_ASSIGNEE_ID=
TRACKER_TEAM_ID=
TRACKER_PROJECT_ID=
TRACKER_EPIC_LABEL_ID=
TRACKER_ISSUE_PREFIX=PROJ

# Git worktree workflow — scripts/worktree-*.sh and .claude/hooks/git-safety.sh
GIT_TRUNK=main
WORKTREE_BRANCH_PREFIX=feature

# daily-note skill — subfolder of $OBSIDIAN_VAULT holding daily notes
OBSIDIAN_DAILY_DIR="Daily Logbook"

# Pupitre session auth — long-lived OAuth token from `claude setup-token`.
# Injected as CLAUDE_CODE_OAUTH_TOKEN into each session's isolated environment.
CLAUDE_CODE_OAUTH_TOKEN=
