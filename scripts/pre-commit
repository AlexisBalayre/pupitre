#!/bin/bash
# Pre-commit hook: enforce code quality and prevent local-only file commits.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Complements the Claude Code Stop hook (.claude/hooks/quality-checks.sh): the Stop
# hook gates agent sessions, this gates human/CLI commits. Commands come from
# .claude/project.env; an empty command is skipped. Tests are the exception: the
# hook runs only the vitest files related to the staged ones, never TEST_CMD.
#
# The profile is read from the MAIN checkout (the git common dir's parent), never
# from the worktree being committed, and parsed rather than sourced: this hook runs
# wherever `git commit` runs, including a session's worktree, and a worktree must not
# choose the commands that run in the operator's shell. A branch that changes
# project.env therefore only affects commits once it is merged.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

COMMON=$(git rev-parse --path-format=absolute --git-common-dir)
MAIN=${COMMON%/.git}

# Same reader as .claude/hooks/lib/project-env.sh, inlined because this file is
# installed outside the tree. Only these keys are read; the file is never executed.
load_project_env() {
  local file="$1" line key val
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    case "$key" in
      SOURCE_EXTENSIONS|LINT_CMD|TYPECHECK_CMD|TEST_CMD) ;;
      *) continue ;;
    esac
    case "$val" in
      \"*\") val=${val#\"}; val=${val%\"} ;;
      \'*\') val=${val#\'}; val=${val%\'} ;;
    esac
    printf -v "$key" '%s' "$val"
  done < "$file"
}
load_project_env "$MAIN/.claude/project.env"

# --- Ensure the repo's Node version (.nvmrc) — shells may default to an older Node ---

REQUIRED_NODE_MAJOR=20
NODE_MAJOR=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$NODE_MAJOR" -lt "$REQUIRED_NODE_MAJOR" ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh"
  nvm use >/dev/null
fi
# pnpm may not exist for this Node version — corepack provides it (pinned via packageManager).
command -v pnpm >/dev/null 2>&1 || corepack enable >/dev/null 2>&1

# --- Block local-only paths ---

BLOCKED_PATHS="docs/plans/ docs/scratch/"

for path in $BLOCKED_PATHS; do
  # Only block additions/modifications, not deletions (allow removing tracked files)
  STAGED=$(git diff --cached --diff-filter=d --name-only -- "$path")
  if [ -n "$STAGED" ]; then
    echo "ERROR: Attempting to commit files under '$path' which is local-only."
    echo "Blocked files:"
    echo "$STAGED" | sed 's/^/  /'
    echo ""
    echo "These files should not be committed to the repository."
    echo "Run 'git reset HEAD -- $path' to unstage them."
    exit 1
  fi
done

# --- Ensure dependencies are installed (worktrees may lack node_modules) ---

if [ ! -d "node_modules/.bin" ]; then
  echo "Installing dependencies..."
  pnpm install --frozen-lockfile
fi

# --- Code quality checks ---

# Each staged path, prefixed with ./ so a name starting with a dash is not an option.
run_on_paths() {
  printf '%s\n' "$1" | sed 's|^|./|' | tr '\n' '\0' | xargs -0 sh -c "$2 \"\$@\"" _
}

STAGED=$(git diff --cached --diff-filter=d --name-only)
EXT_RE=$(printf '%s' "${SOURCE_EXTENSIONS:-}" | tr -s ' ' '|')
STAGED_SOURCE=""
if [ -n "$EXT_RE" ]; then
  STAGED_SOURCE=$(printf '%s\n' "$STAGED" | grep -E "\.($EXT_RE)$" || true)
fi

# Every staged file, whatever its extension: the linter's own includes decide
# which it checks, and LINT_CMD carries --no-errors-on-unmatched for the rest.
if [ -n "${LINT_CMD:-}" ] && [ -n "$STAGED" ]; then
  echo "Running lint: $LINT_CMD"
  if ! run_on_paths "$STAGED" "$LINT_CMD"; then
    echo ""
    echo "ERROR: Lint failed on staged files. Run 'pnpm lint:fix' to auto-fix issues."
    exit 1
  fi
fi

# Typecheck only what a type can break: source, or the config that shapes it (decision 135).
STAGED_TYPED=$(git diff --cached --name-only | grep -E '\.(ts|tsx)$|^(package\.json|tsconfig[^/]*\.json)$' || true)

if [ -n "${TYPECHECK_CMD:-}" ] && [ -n "$STAGED_TYPED" ]; then
  echo "Running TYPECHECK_CMD: $TYPECHECK_CMD"
  if ! bash -c "$TYPECHECK_CMD"; then
    echo ""
    echo "ERROR: TYPECHECK_CMD failed. Fix it before committing."
    exit 1
  fi
fi

# Only the test files that import a staged source file, directly or through
# others, and the staged test files themselves (decision 135). The full suite
# is TEST_CMD's, which the merge gate's test stage runs; an empty TEST_CMD still
# turns tests off here. A commit with no staged source runs no tests.
#
# Inside a pup session (PUP_SESSION_ID set) the run queues for one of the machine's
# test slots through `pup session test`, and yields to a merge gate (decisions 96,
# 160). The tests are listed first, which starts none: `vitest list --filesOnly
# --changed` names those that import a file changed in the working tree, staged or
# not, and `vitest related` has no list form. A failed listing blocks the commit; only
# a clean listing with no file, vitest's own "no related tests", runs nothing.
RELATED_TEST_CMD="pnpm exec vitest related --run --passWithNoTests"
if [ -n "${TEST_CMD:-}" ] && [ -n "$STAGED_SOURCE" ]; then
  if [ -n "${PUP_SESSION_ID:-}" ]; then
    # Fail closed: a session that cannot reach pup runs no tests, so it commits none.
    if command -v pup >/dev/null 2>&1; then
      PUP_CMD=(pup)
    elif [ -n "${PUP_BIN:-}" ] && [ -f "$PUP_BIN" ]; then
      PUP_CMD=(node "$PUP_BIN")
    else
      echo ""
      echo "ERROR: pup is not on the PATH and PUP_BIN is not a file: the related tests cannot run through a test slot."
      exit 1
    fi
    echo "Running related tests through a test slot (waits for a free one)"
    if ! RELATED_FILES=$(pnpm exec vitest list --filesOnly --changed); then
      echo ""
      echo "ERROR: Listing the tests related to the staged files failed."
      exit 1
    fi
    if [ -n "$RELATED_FILES" ]; then
      if ! (set -o pipefail; printf '%s\n' "$RELATED_FILES" | tr '\n' '\0' | xargs -0 "${PUP_CMD[@]}" session test --); then
        echo ""
        echo "ERROR: Tests related to the staged files failed. Fix them before committing."
        exit 1
      fi
    fi
  else
    echo "Running related tests: $RELATED_TEST_CMD"
    if ! run_on_paths "$STAGED_SOURCE" "$RELATED_TEST_CMD"; then
      echo ""
      echo "ERROR: Tests related to the staged files failed. Fix them before committing."
      exit 1
    fi
  fi
fi

echo "All pre-commit checks passed."
